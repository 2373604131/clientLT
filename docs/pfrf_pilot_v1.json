{
  "schema_version": "pfrf_pilot_design_v1",
  "status": "smoke_code_implemented_real_runs_pending",
  "protocol_document": "docs/pfrf_pilot_protocol.md",
  "primary_method": "pfrf_max",
  "target_semantics": "persistent_absolute_target_not_old_residual_max",
  "output_root": "output/pfrf_smoke_v1",
  "common": {
    "dataset": "cifar100_LT",
    "partition": "client-longtail",
    "seed": 42,
    "split_seed": 42,
    "common_init_seed": 42,
    "num_users": 30,
    "frac": 1.0,
    "client_order": "shared_seeded_per_round_permutation",
    "imb_factor": 0.01,
    "imb_type": "exp",
    "specialization_lambda": 0.75,
    "intra_group_alpha": 0.5,
    "head_leakage_scale": 3.0,
    "head_client_ratio": 0.9,
    "tail_client_ratio": 0.1,
    "head_class_ratio": 0.8,
    "backbone": "ViT-B/16",
    "encoder": "vision",
    "lora_position": "top3",
    "lora_params": ["q", "v"],
    "lora_rank": 2,
    "lora_alpha": 1,
    "lora_scaling": "read_module_scaling_currently_alpha_over_sqrt_rank",
    "lora_dropout": 0.0,
    "precision": "fp32",
    "optimizer": "sgd",
    "lr": 0.001,
    "lr_policy": "constant",
    "optimizer_other_fields": "inherit_resolved_baseline_and_hash",
    "reset_optimizer_per_client_round": true,
    "reset_optimizer_between_local_phases": false,
    "proposal_epochs": 2,
    "correction_epochs": 1,
    "train_batch_size": 32,
    "eval_batch_size": 64,
    "num_workers": 0,
    "aggregation": "effective_absolute_adapter_rank_r_svd",
    "aggregation_weights": "sample_count",
    "aux_lambda": 1.0,
    "function": "class_mean_true_class_softmax_probability",
    "function_temperature": 1.0,
    "freeze_logit_scale": true,
    "memory_max_samples": 32,
    "train_audit_max_samples": 28,
    "memory_transform": "repository_cifar_deterministic_to_tensor_normalize_resize224",
    "remove_train_audit_from_ce": false,
    "train_audit_is_unseen": false,
    "external_probe": "train_raw_ids_outside_entire_federated_lt_pool",
    "external_probe_samples_per_tail_class": 10,
    "external_probe_training_access": false,
    "tail_definition": "bottom_20_classes_by_frozen_counts_repository_tie_break",
    "disabled_components": ["SCA", "Stage3", "E1", "ExperimentD"]
  },
  "conditions": [
    {"id": "B0", "name": "ordinary_ce", "auxiliary": "none", "memory_backward": false},
    {"id": "B1", "name": "matched_memory_ce", "auxiliary": "sample_mean_memory_ce", "memory_backward": true},
    {"id": "B2", "name": "class_reweighted_ce", "auxiliary": "inverse_sqrt_local_count_memory_ce_weights_sample_mean_one", "memory_backward": true},
    {"id": "B3", "name": "instantaneous_target", "auxiliary": "class_mean_squared_hinge_target_current_ce_proposal", "memory_backward": true},
    {"id": "M1", "name": "pfrf_max", "auxiliary": "class_mean_squared_hinge_target_persistent_ce_peak", "memory_backward": true},
    {"id": "A1", "name": "pfrf_add", "auxiliary": "class_mean_squared_hinge_target_additive_pending", "memory_backward": true, "absolute_target_cap": 1.0}
  ],
  "smoke": {
    "rounds": 5,
    "conditions": "all_six",
    "requires_synthetic_unit_tests": true,
    "resume_conditions": ["pfrf_max", "pfrf_add"],
    "checkpoint_after_round": 2,
    "resume_to_round": 5,
    "fp64_atol": 1e-10,
    "fp64_rtol": 1e-8,
    "fp32_atol": 1e-6,
    "fp32_rtol": 1e-5,
    "accuracy_improvement_required": false,
    "required_output": "smoke_report.json"
  },
  "kill_test": {
    "rounds": 100,
    "fresh_initialization_after_smoke": true,
    "technical_review_round": 20,
    "performance_early_stopping": false,
    "primary_endpoint": "round_100_tail_macro_accuracy",
    "late_window": [81, 100],
    "eval_rounds": "1_through_100",
    "primary_controls": ["matched_memory_ce", "class_reweighted_ce", "instantaneous_target"],
    "screening_tail_gain_vs_best_control_pp": 1.0,
    "screening_max_non_tail_drop_vs_b0_pp": 1.0,
    "screening_max_overall_drop_vs_b0_pp": 1.0,
    "late_window_gain_must_be_positive": true,
    "unseen_probe_directional_support_required": true,
    "single_seed_significance_claim": false,
    "possible_outcomes": ["pass", "inconclusive", "fail", "invalid"]
  },
  "optional_exploration_separate_version": {
    "automatic": false,
    "lambda_candidates": [0.1, 1.0, 10.0],
    "equal_search_budget_conditions": ["B1", "B2", "B3", "M1", "A1"],
    "selection_data": "external_train_probe_reclassified_as_development",
    "test_selection_allowed": false
  },
  "confirmation_after_pass": {
    "automatic": false,
    "new_seeds": [1, 2, 3, 2026, 2027],
    "inference_unit": "paired_training_seed"
  }
}
