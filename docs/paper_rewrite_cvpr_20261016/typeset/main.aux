\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 相同长尾样本池下的尾部类别保持。左：尾部样本最多的 3 个客户端所持尾部样本比例。右：相同交替因子训练策略下的 Tail20 准确率；Matched 同时固定类别总量与客户端样本总量。曲线均使用 rank-4 LoRA、全局 LA、样本量聚合与训练种子 42。}}{2}{figure.caption.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 整体框架。客户端更新首先形成普通聚合模型。方法 B 通过本地反馈学习更新组合；方法 A 利用来源响应和历史预测间隔修正适配结果。所有反馈图像保留在所属客户端，服务器根据反馈量与梯度协调优化。}}{3}{figure.caption.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces CIFAR-100-LT、Client-LT 上的分类准确率（\%）。同一骨干下各方法采用其对应训练流程；数值为种子 42 的末 20 轮均值。}}{4}{table.caption.9}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces 样本量聚合协议下的配对模块实验（\%）。列分别对应训练种子 42 和 3407，均报告末 20 轮平均准确率。}}{4}{table.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces 同起点五轮训练后的 Tail20 样本变化，共 2,000 张测试图像。两个起点准确率分别为 71.55\% 和 71.25\%。}}{5}{table.3}\protected@file@percent }
